# Frontend Environment Variables
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=Reseller Apple

# Backend Environment Variables
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/reseller_apple

# JWT Secret (ZMIEŃ NA WŁASNY - minimum 32 znaki!)
JWT_SECRET=twoj_super_tajny_klucz_jwt_minimum_32_znaki_losowych

# Session Secret (ZMIEŃ NA WŁASNY!)
SESSION_SECRET=twoj_super_tajny_klucz_sesji_minimum_32_znaki

# Email Configuration (opcjonalne)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=twoj_email@gmail.com
SMTP_PASS=twoje_haslo_aplikacji

# Payment Gateway (Przelewy24)
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_API_KEY=

# Stripe (opcjonalne)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# Redis (opcjonalne - dla cache)
REDIS_URL=redis://localhost:6379

# Upload limits
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100